# =============================================================================
# AureaOps — variáveis de ambiente (EXEMPLO)
# Copie para .env (n8n local) e/ou configure nas plataformas indicadas.
# NUNCA versione o .env real. Nenhum valor abaixo é uma credencial verdadeira.
# =============================================================================

# ---- n8n (self-hosted via npm: use o arquivo .env na raiz do projeto n8n ou
#      Settings > Variables na interface; no n8n Cloud só existe a 2ª opção) ----
N8N_HOST=http://localhost:5678
N8N_PORT=5678
# Fuso do agendador do n8n (triggers de SLA/relatórios) — TODO(manual): conferir em Settings > Timezone
GENERIC_TIMEZONE=America/Sao_Paulo

# ---- Autenticação dos webhooks (API Key) ----
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY_F1=troque-por-uma-chave-aleatoria-de-48-hex
API_KEY_F2=troque-por-outra-chave-aleatoria-de-48-hex

# ---- WhatsApp (regra 5 do projeto) ----
# simulado = grava em log + envia por e-mail (não precisa de conta Meta)
# real     = WhatsApp Cloud API ( exige os 3 valores abaixo )  [TODO(manual)]
MODO_WHATSAPP=simulado
WHATSAPP_TOKEN=TODO-manual-accessToken-meta
WHATSAPP_PHONE_NUMBER_ID=TODO-manual-phone-number-id
WHATSAPP_API_VERSION=v21.0
# Template de mensagem aprovado na Meta (obrigatório fora da janela de 24h)
WHATSAPP_TEMPLATE_CHAMADO=chamado_aberto

# ---- E-mail (SMTP do Gmail com senha de app — 2FA obrigatório) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu.usuario@gmail.com
SMTP_PASS=TODO-manual-senha-de-app-16-caracteres

# ---- Papéis do negócio (dados fictícios) ----
GESTOR_EMAIL=renato.campos@aureahome.example
GESTOR_WHATSAPP=5500900000000
ATENDENTE_SAC_EMAIL=sac@aureahome.example
ATENDENTE_SAC_WHATSAPP=5500900000001

# ---- Google (o OAuth2 é autorizado DENTRO do n8n ao conectar o node Google
#      Sheets; aqui fica só o id da planilha espelho) ----
GOOGLE_SHEETS_ID=TODO-manual-id-da-planilha-aureaops

# ---- Base44 ----
# TODO(manual): confirme o padrão exato da URL na documentação do seu app
BASE44_API_URL=https://app.base44.com/api/apps/TODO-manual-app-id/resources
BASE44_API_KEY=TODO-manual-api-key-do-app

# ---- Apps Script (NÃO usa .env: os segredos ficam em Script Properties) ----
# Chaves que você criará em Configurações do projeto > Propriedades do script:
#   API_KEY_LEADS          = mesmo valor de API_KEY_F2
#   SPREADSHEET_ID         = mesmo valor de GOOGLE_SHEETS_ID
#   DRIVE_PASTA_LEADS_ID   = id da pasta "AureaOps/Leads" no Drive
#   VENDEDORES             = [{"nome":"Ana Souza","email":"ana.souza@aureahome.example"},...]
#   RR_PONTEIRO            = 0  (contador do round-robin)
#   N8N_SYNC_URL           = (opcional) URL do webhook f2-lead-sync no n8n
