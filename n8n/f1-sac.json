      "name": "Ler Chamados (SLA)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -1160,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const linhas = $input.all().map(function (i) { return i.json; });\nconst agora = Date.now();\nconst vencidos = linhas.filter(function (l) {\n  const aberto = Date.parse(String(l.aberto_em || ''));\n  if (isNaN(aberto)) return false;\n  const horas = (agora - aberto) / 3600000;\n  return !['resolvido', 'cancelado'].includes(String(l.status)) &&\n    Number(l.escalado) === 0 &&\n    horas > Number(l.sla_horas || 0);\n});\nreturn vencidos.map(function (l) {\n  return { json: {\n    request_id: l.request_id,\n    protocolo: l.protocolo,\n    prioridade: l.prioridade,\n    motivo: l.motivo,\n    sla_horas: l.sla_horas,\n    aberto_em: l.aberto_em,\n    nome: l.nome,\n    horas_vencidas: Math.round(((agora - Date.parse(l.aberto_em)) / 3600000) * 10) / 10\n  }};\n});"
      },
      "id": "69a4ad01-5310-4952-839d-95a39f3b869a",
