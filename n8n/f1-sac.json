    {
      "parameters": {
        "jsCode": "const dados = $('Validar e Classificar').first().json;\nconst c = dados.chamado;\nconst pedidos = $input.all().map(function (i) { return i.json; });\nconst pedido = pedidos.find(function (p) {\n  return String(p.numero_pedido || '').toUpperCase() === c.numero_pedido;\n});\nconst agora = new Date().toISOString();\nconst protocolo = 'SAC-' + agora.slice(0, 10).replace(/-/g, '') + '-' + String(Math.floor(1000 + Math.random() * 9000));\nreturn [{ json: {\n  protocolo: protocolo,\n  aberto_em: agora,\n  nome: c.nome,\n  email: c.email,\n  telefone: c.telefone,\n  numero_pedido: pedido ? c.numero_pedido : '',\n  motivo: c.motivo,\n  prioridade: c.prioridade,\n  sla_horas: c.sla_horas,\n  status: 'aberto',\n  descricao: c.descricao,\n  vinculo_pedido_ok: pedido ? 1 : 0,\n  escalado: 0,\n  request_id: c.request_id,\n  primeira_resposta_em: '',\n  resolvido_em: '',\n  created_at: agora\n}}];"
      },
