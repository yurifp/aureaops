      "id": "8a9f7d6d-0b46-412a-8ba9-3b874406f279",
      "name": "Criar no Base44",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1060,
        -40
      ]
    },
    {
      "parameters": {
        "jsCode": "const chamado = $('Preparar Chamado').first().json;\nlet b44status = null;\ntry {\n  const r = $('Criar no Base44').first().json;\n  if (r.statusCode !== undefined) b44status = Number(r.statusCode);\n} catch (e) { b44status = null; }\nconst b44ok = b44status !== null && b44status >= 200 && b44status < 300;\nconst modoWhats = $env.MODO_WHATSAPP === 'real' ? 'real' : 'simulado';\nconst resumoWhats = 'Novo chamado ' + chamado.protocolo + ' (' + chamado.prioridade + ') - ' + chamado.motivo + ' - pedido ' + (chamado.numero_pedido || 'nao localizado') + ' - cliente ' + chamado.nome;\nconst destinatarioWhats = chamado.prioridade === 'alta' ? $env.GESTOR_WHATSAPP : $env.ATENDENTE_SAC_WHATSAPP;\nconst whatsBody = {\n  messaging_product: 'whatsapp',\n  to: destinatarioWhats,\n  type: 'template',\n  template: {\n    name: $env.WHATSAPP_TEMPLATE_CHAMADO || 'chamado_aberto',\n    language: { code: 'pt_BR' },\n    components: [{ type: 'body', parameters: [\n      { type: 'text', text: chamado.protocolo },\n      { type: 'text', text: chamado.motivo },\n      { type: 'text', text: chamado.prioridade }\n    ]}]\n  }\n};\nconst avisoHtml = '<h2>Novo chamado ' + chamado.protocolo + '</h2>' +\n  '<ul>' +\n  '<li><b>Prioridade:</b> ' + chamado.prioridade + ' (SLA ' + chamado.sla_horas + 'h)</li>' +\n  '<li><b>Motivo:</b> ' + chamado.motivo + '</li>' +\n  '<li><b>Cliente:</b> ' + chamado.nome + '</li>' +\n  '<li><b>Pedido:</b> ' + (chamado.numero_pedido || 'nao localizado') + '</li>' +\n  '<li><b>Base44:</b> ' + (b44ok ? 'gravado' : 'PENDENTE (nova tentativa via sync F2/lote)') + '</li>' +\n  '<li><b>WhatsApp:</b> ' + modoWhats + (modoWhats === 'simulado' ? ' - conteudo que seria enviado: <i>' + resumoWhats + '</i>' : '') + '</li>' +\n  '</ul>' +\n  '<p>' + chamado.descricao + '</p>';\nreturn [{ json: {\n  criado_em: new Date().toISOString(),\n  fluxo: 'F1',\n  evento: 'chamado_processado',\n  status: b44ok ? 'sucesso' : 'aviso',\n  request_id: chamado.request_id,\n  http_status: b44status === null ? '' : b44status,\n  detalhe: JSON.stringify({ base44_ok: b44ok, whatsapp: modoWhats, vinculo_pedido_ok: chamado.vinculo_pedido_ok }),\n  aviso_para: $env.ATENDENTE_SAC_EMAIL,\n  aviso_assunto: '[AureaOps] Novo chamado ' + chamado.protocolo + ' (' + chamado.prioridade + ')',\n  aviso_html: avisoHtml,\n  whats_para: destinatarioWhats,\n  whats_body: whatsBody\n}}];"
      },
