        "jsCode": "const dados = $('Validar e Classificar').first().json;\nconst linhas = $input.all().map(function (i) { return i.json; });\nconst dup = linhas.find(function (l) {\n  return String(l.request_id || '') === String(dados.chamado.request_id || '');\n});\nreturn [{ json: { duplicado: Boolean(dup), protocolo_original: dup ? dup.protocolo : null } }];"
