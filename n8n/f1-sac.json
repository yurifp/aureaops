    {
      "parameters": {
        "jsCode": "const entrada = items[0].json;\nconst corpo = entrada.body || {};\nconst cabecalhos = entrada.headers || {};\nconst erros = {};\n\nconst esperada = $env.API_KEY_F1;\nconst recebida = cabecalhos['x-api-key'] || cabecalhos['X-Api-Key'];\nconst autenticado = Boolean(esperada) && recebida === esperada;\n\nconst uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst emailRegex = /^[^s@]+@[^s@]+.[^s@]+$/;\n\nif (!uuidRegex.test(String(corpo.request_id || ''))) erros.request_id = ['request_id deve ser um UUID v4.'];\nif (!corpo.nome || String(corpo.nome).trim().length < 3) erros.nome = ['Informe o nome completo.'];\nif (!emailRegex.test(String(corpo.email || ''))) erros.email = ['E-mail invalido.'];\nconst digitos = String(corpo.telefone || '').replace(/[^0-9]/g, '');\nif (digitos.length < 8) erros.telefone = ['Telefone invalido (com DDD).'];\nif (!/^PED-[0-9]{4}-[0-9]{4}$/.test(String(corpo.numero_pedido || ''))) erros.numero_pedido = ['Pedido no formato PED-2026-1001.'];\nif (!['troca','atraso','defeito','duvida'].includes(corpo.motivo)) erros.motivo = ['Motivo invalido.'];\nif (!corpo.descricao || String(corpo.descricao).trim().length < 10) erros.descricao = ['Descreva com pelo menos 10 caracteres.'];\nif (corpo.consentimento_lgpd !== true) erros.consentimento_lgpd = ['Consentimento LGPD obrigatorio.'];\n\nconst mapaSla = { defeito: ['alta', 4], troca: ['media', 24], atraso: ['media', 24], duvida: ['baixa', 72] };\nconst par = mapaSla[corpo.motivo] || ['', 0];\n\nreturn [{ json: {\n  autenticado,\n  erros,\n  chamado: {\n    request_id: corpo.request_id,\n    nome: String(corpo.nome || '').trim(),\n    email: String(corpo.email || '').trim().toLowerCase(),\n    telefone: String(corpo.telefone || '').trim(),\n    numero_pedido: String(corpo.numero_pedido || '').trim().toUpperCase(),\n    motivo: corpo.motivo || '',\n    descricao: String(corpo.descricao || '').trim(),\n    prioridade: par[0],\n    sla_horas: par[1]\n  }\n}}];"
      },
